{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run build:vercel",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "app.vinhaigrejas.com.br" }],
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "central.vinhaigrejas.com.br" }],
      "destination": "/central-vinha/login",
      "permanent": false
    },
    {
      "source": "/login",
      "has": [{ "type": "host", "value": "central.vinhaigrejas.com.br" }],
      "destination": "https://app.vinhaigrejas.com.br/login",
      "permanent": false
    },
    {
      "source": "/painel/:path*",
      "has": [{ "type": "host", "value": "central.vinhaigrejas.com.br" }],
      "destination": "https://app.vinhaigrejas.com.br/painel/:path*",
      "permanent": false
    },
    {
      "source": "/central-vinha/:path*",
      "has": [{ "type": "host", "value": "app.vinhaigrejas.com.br" }],
      "destination": "https://central.vinhaigrejas.com.br/central-vinha/:path*",
      "permanent": false
    },
    {
      "source": "/admin-vinha/:path*",
      "has": [{ "type": "host", "value": "app.vinhaigrejas.com.br" }],
      "destination": "https://central.vinhaigrejas.com.br/admin-vinha/:path*",
      "permanent": false
    }
  ]
}
