NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_AQUI

# Apenas no servidor. Necessária para os retornos autenticados de pagamento.
SUPABASE_SECRET_KEY=
# Chave forte e estável para criptografar credenciais dos provedores.
PAYMENT_CREDENTIALS_MASTER_KEY=
# Token usado pela Vercel para autenticar a rotina diária (08h Brasília).
CRON_SECRET=
# Envios financeiros: manter desligados até teste autorizado e validação dos canais.
BILLING_NOTIFICATIONS_ENABLED=false
BILLING_RESEND_WEBHOOK_SECRET=
BILLING_META_APP_SECRET=
BILLING_WHATSAPP_VERIFY_TOKEN=
# Somente homologação Asaas, jamais habilita recorrência ou emissão fiscal real.
FINANCIAL_SANDBOX_ENABLED=false

# F3: exclusivamente no servidor. Chave aleatória de 32 bytes em base64.
# Não reutilizar entre homologação e produção; preservar para ler as conexões existentes.
FINANCE_RECEIVER_ENCRYPTION_KEY=
# Aplicativos OAuth independentes; retornos fixos, sem parâmetros.
# Caminho obrigatório: /api/finance-receivers/callback
FINANCE_MP_TEST_CLIENT_ID=
FINANCE_MP_TEST_CLIENT_SECRET=
FINANCE_MP_TEST_REDIRECT_URI=
FINANCE_MP_LIVE_CLIENT_ID=
FINANCE_MP_LIVE_CLIENT_SECRET=
FINANCE_MP_LIVE_REDIRECT_URI=
FINANCE_MP_TEST_WEBHOOK_SECRET=
FINANCE_MP_LIVE_WEBHOOK_SECRET=
